{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Will Multimedia",
  "version": "1.0.0",
  "identifier": "com.willmultimedia.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Will Multimedia",
        "width": 1150,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#090d16"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "LICENSE.txt",
    "copyright": "Copyright © 2026 Will Multimedia. Todos los derechos reservados.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Will Multimedia"
      }
    }
  }
}
