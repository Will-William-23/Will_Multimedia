{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Will Multimedia",
  "version": "1.0.0",
  "identifier": "com.willmultimedia.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Will Multimedia",
        "width": 1150,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#090d16",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,TranslateUI --disable-extensions --disable-component-update --disable-background-networking --disable-sync --no-pings --renderer-process-limit=1"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "LICENSE.txt",
    "copyright": "Copyright © 2026 Will Multimedia. Todos los derechos reservados.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v", "ts", "3gp"],
        "name": "Archivo de Video Will Multimedia",
        "description": "Video reproducible con Will Multimedia",
        "role": "Viewer"
      },
      {
        "ext": ["mp3", "wav", "flac", "aac", "ogg", "m4a", "wma", "opus", "aiff"],
        "name": "Archivo de Audio Will Multimedia",
        "description": "Audio reproducible con Will Multimedia",
        "role": "Viewer"
      },
      {
        "ext": ["jpg", "jpeg", "png", "webp", "gif", "bmp", "svg", "avif", "ico"],
        "name": "Imagen Will Multimedia",
        "description": "Imagen visualizable con Will Multimedia",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Will Multimedia"
      }
    }
  }
}
